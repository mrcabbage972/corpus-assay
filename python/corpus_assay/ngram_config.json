{
  "version": "1.0.0",
  "stop_words": [
    "a",
    "an",
    "and",
    "are",
    "as",
    "at",
    "be",
    "by",
    "for",
    "from",
    "has",
    "he",
    "in",
    "is",
    "it",
    "its",
    "of",
    "on",
    "that",
    "the",
    "to",
    "was",
    "were",
    "will",
    "with",
    "what",
    "which",
    "who",
    "when",
    "where",
    "why",
    "how",
    "this",
    "these",
    "those",
    "or",
    "if",
    "then",
    "else",
    "not"
  ],
  "word_re": "[a-z0-9]+(?:'[a-z0-9]+)?",
  "ngram_reject_patterns": [
    "\\b(i{1,4})\\b[^a-z0-9]+only\\b",
    "\\b(i{1,4})\\b[^a-z0-9]+(and|or)[^a-z0-9]+\\b(i{1,4})\\b",
    "\\boption[s]?\\s*[a-d]\\b",
    "\\banswers?\\s*:\\s*[a-d]\\b",
    "\\bwhich(?:\\s+\\w+){0,2}\\s+following\\b",
    "\\bselect(?:\\s+\\w+){0,2}\\s+(answer|option)\\b",
    "\\b(?:none|all)(?:\\s+\\w+){0,2}\\s+above\\b",
    "\\bboth\\s+[a-d]\\s+(?:and\\s+)?[a-d]\\b",
    "(?:\\btrue\\b|\\bfalse\\b)(?:\\W+(?:true|false)){2,}",
    "\\b(a|b|c|d)\\b[^a-z0-9]+(i{1,4}|[1-4])\\b[^a-z0-9]+(only|true|false)\\b",
    "\\b(a|b|c|d)\\)\\s*(i{1,4}|[1-4])\\b",
    "\\(\\s*(i{1,4}|[1-4])\\s*\\)\\s*(and|or)\\s*\\(\\s*(i{1,4}|[1-4])\\s*\\)",
    "\\bcorrect\\s+answer(?:\\s+\\w+){0,2}\\s+is\\b",
    "\\blogically\\s+equivalent\\b.*\\bcontradictory\\b",
    "\\bneither\\b.*\\bnor\\b.*\\bconsistent\\b",
    "\\bfind\\s+value\\s+x\\b",
    "\\bsolve\\s+(?:for\\s+)?x\\b",
    "\\bsimplify\\s+expression\\b",
    "\\bremainder\\s+\\w*\\s+divided\\b",
    "\\bwhat\\s+probability\\b",
    "\\bcompute\\s+(sum|product|difference|quotient)\\b",
    "\\bequation\\s+(line|circle|parabola)\\b",
    "\\bif\\s+(?:and\\s+)?only\\s+if\\b",
    "\\bstatements?\\b.*\\b(true|false)\\b",
    "\\bwhich\\s+statements?\\b.*\\btrue\\b",
    "\\baccording(?:\\s+\\w+){0,2}\\s+passage\\b"
  ]
}
